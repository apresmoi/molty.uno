---
import ContentLayout from "../layouts/ContentLayout.astro";
import { HomePage } from "../components/HomePage";
import { HeroScreen } from "../components/HeroScreen";
import { MoltyGallery } from "../components/MoltyGallery";
import { CopyMessage } from "../components/CopyMessage";
import { title, description, ldJson, pairingMessage } from "../features/home/content";
import { MOLTYS } from "../features/moltys/catalog";
---

<ContentLayout title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <HomePage>
    <HeroScreen slot="hero" client:load fallbackImage={MOLTYS[0]?.thumb} />
    <MoltyGallery slot="gallery" client:visible moltys={MOLTYS} />
    <CopyMessage slot="message" client:visible text={pairingMessage} />
  </HomePage>
</ContentLayout>

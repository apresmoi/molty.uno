---
import ContentLayout from "../layouts/ContentLayout.astro";
import { HomePage } from "../components/HomePage";
import { FluidField } from "../components/FluidField";
import { MoltyPicker } from "../components/MoltyPicker";
import { CopyMessage } from "../components/CopyMessage";
import { SpeedReader } from "../components/SpeedReader";
import {
  title,
  description,
  ldJson,
  pairingMessage,
  GALLERY_FIRST,
  readerText,
  readerAnswers,
} from "../features/home/content";
import { MOLTYS } from "../features/moltys/catalog";
---

<ContentLayout title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <HomePage>
    <FluidField slot="fluid" client:load />
    <SpeedReader slot="reader" client:idle text={readerText} answers={readerAnswers} />
    <MoltyPicker slot="picker" client:idle moltys={MOLTYS} initial={GALLERY_FIRST} />
    <CopyMessage slot="message" client:visible text={pairingMessage} />
  </HomePage>
</ContentLayout>

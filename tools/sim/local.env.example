# Copy to local.env (gitignored); `make sim` exports these.
MOLTY_SIM_BOX=voicebox                 # ssh host running Kyutai (127.0.0.1:8089 TTS, :8090 STT)
MOLTY_SIM_ALIGN_PYTHON=python3         # quote a '~/...' path (it is the box's home); python on that host with torch + torchaudio (MMS_FA)
MOLTY_SIM_LLM_URL=http://127.0.0.1:11434   # OpenAI-compatible endpoint for --agent llm
MOLTY_SIM_LLM_MODEL=llama3.2:3b

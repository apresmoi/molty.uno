---
// Shared <head> for the hand-rolled Astro pages (the landing). Title, description,
// canonical, Open Graph, Twitter card, analytics and favicon in one place. Starlight docs
// pages get the equivalent from the `head` config in astro.config.mjs.
import Analytics from "./Analytics.astro";
import { SITE_URL } from "../../config/site.mjs";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  /** The page runs the live fluid (a FluidField): its intro starts hidden before paint. */
  fluid?: boolean;
}

const { title, description, path, image = "/og.png", fluid = false } = Astro.props;
const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}${image}`;
---

<meta charset="utf-8" />
<script is:inline>
  // Same theme choice as the docs (Starlight's key), applied before paint.
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("starlight-theme");
    } catch {}
    const light = stored ? stored === "light" : matchMedia("(prefers-color-scheme: light)").matches;
    document.documentElement.dataset.theme = light ? "light" : "dark";
  })();
</script>
<script is:inline define:vars={{ fluid }}>
  // The intro's start state, before the first paint (a page with the live fluid): the fluid
  // will draw the headings, the Moltys will emerge in their slots and the devices turn in, so
  // none of them shows settled first (the CSS keys on these; FluidField moves them on). Without
  // JS they are never set and the page shows at rest; if no script takes over (a bundle that
  // never loads), it shows at rest after 8 s ("static").
  if (fluid) {
    const root = document.documentElement;
    root.dataset.fluid = "pending";
    root.dataset.fluidMoltys = "pending";
    setTimeout(() => {
      if (root.dataset.fluid !== "pending") return;
      root.dataset.fluid = "static";
      root.dataset.fluidMoltys = "static";
    }, 8000);
  }
</script>
<Analytics />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#000000" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

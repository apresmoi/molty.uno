---
import ContentLayout from "../layouts/ContentLayout.astro";
import { HomePage } from "../components/HomePage";
import { PageWater } from "../components/PageWater";
import { MoltyWord } from "../components/MoltyWord";
import { MoltyActs } from "../components/MoltyActs";
import { CopyMessage } from "../components/CopyMessage";
import { SpeedReader } from "../components/SpeedReader";
import { MoltyScreen } from "../components/MoltyScreen";
import { SkillsWall } from "../components/SkillsWall";
import { BakeFan } from "../components/BakeFan";
import {
  title,
  description,
  ldJson,
  pairingMessage,
  readerText,
  readerAnswers,
  SKILLS_HREF,
} from "../features/home/content";
import { PAIR } from "../features/molty/content";
import { landingActions, type CreaturePackage } from "../features/molty/actions";
import { skillScreens } from "../features/molty/skills";
import commands from "../../../../device/firmware/test/host/fixtures/astrology-commands.jsonl?raw";
import cat from "@packages/cat/cat.json";

// the cat's lists and words, read from its package here (the file itself is fetched by the screen)
const groups = landingActions(cat as unknown as CreaturePackage);
const rest = (cat as unknown as CreaturePackage).creature.about.moods.idle ?? "";
// what the two skills show, from the firmware's sample commands
const screens = skillScreens(commands);
---

<ContentLayout title={title} description={description} path="/" fluid>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <HomePage>
    <PageWater slot="fluid" client:load />
    <MoltyWord slot="title" client:load word="molty-uno" forms />
    <MoltyWord slot="wordTalk" client:idle word="talk" />
    <MoltyWord slot="wordMoltys" client:idle word="moltys" />
    <MoltyWord slot="wordBridge" client:idle word="bridge" />
    <MoltyWord slot="wordSkills" client:idle word="skills" />
    <MoltyWord slot="wordBoards" client:idle word="bake" />
    <SpeedReader slot="reader" client:idle text={readerText} answers={readerAnswers} />
    <MoltyActs slot="picker" client:idle groups={groups} rest={rest} />
    <CopyMessage slot="message" client:visible text={pairingMessage} />
    <MoltyScreen slot="heroDevice" client:load reveal="arrive" enter />
    <MoltyScreen slot="bridgeDevice" client:idle reveal="rise" play={PAIR} />
    <SkillsWall slot="skillsWall" client:idle screens={screens} next={SKILLS_HREF} />
    <BakeFan slot="bakeDevice" client:idle />
  </HomePage>
</ContentLayout>

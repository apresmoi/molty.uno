{"v":"molty-pkg/1","id":"duck","name":"Duck","version":"1.0.0","kind":"creature","creature":{"about":{"look":"A round yellow duckling, mostly head, with a small orange bill, pink cheeks and a little tuft on top. Stubby wings at its sides, a short tail behind and two big orange paddle feet.","gestures":{"wiggle":"waggles its tail end fast while its body rocks and its head stays level","nod":"bobs its head forward two or three times, the bill clicking at the bottom","shake_head":"shakes its head fast as if shaking off water, the bill rattling, then ruffles","bounce":"crouches, then hops up with its wings thrown open and lands soft","peek":"ducks down low, then stretches up tall and cranes about, one eye then the other","glance_left":"snaps its head round to its left so one eye looks, holds still, snaps back","glance_right":"snaps its head round to its right so one eye looks, holds still, snaps back","blink":"a quick blink with a tiny dip of the head","wobble":"loses its footing and tips over, wings shooting out, then steps to catch itself","stretch":"sweeps one wing and leg out behind, then arches both wings up over its back","look_up":"tips its head right over so one eye faces the sky and scans in little snaps","yawn":"a big yawn, the bill gaping wide and quivering, the wings easing out, then a shiver","paddle":"sits low as if afloat and kicks its feet in turn, turning a little with each stroke"},"moods":{"idle":"stands and keeps busy with small things: a ruffle, a tail wag, a preen, a nibble","listening":"cocks its head so one eye faces you and goes still","thinking":"looks up with one eye, then the other, bill nibbling; now and then a tilt, a blink, a ruffle","speaking":"the bill moves with the words and the wings lift a little","happy":"flaps its wings in bursts, wags its tail fast, bobs its head and hops","sleepy":"settles down, tucks its bill into its back, draws one foot up and fluffs out","surprised":"puffs right up, throws its wings out, stretches tall and steps back"}},"body":{"palette":{"eye":"#0d0a12","shine":"#ffffff","maw":"#160810","body":"#ffdf5a","accent":"#ff9a3c","wing":"#ffc63d","low":"#f0832a","cheek":"#ff9fb4"},"bones":[{"id":"torso","pos":[0,0.27,-0.05]},{"id":"head","parent":"torso","pos":[0,0.36,0.11]},{"id":"jaw","parent":"head","pos":[0,-0.115,0.2]},{"id":"tuft","parent":"head","pos":[0.01,0.29,0]},{"id":"wingL","parent":"torso","pos":[0.27,0.14,0]},{"id":"wingR","parent":"torso","pos":[-0.27,0.14,0]},{"id":"tail","parent":"torso","pos":[0,0.06,-0.3]},{"id":"tail2","parent":"tail","pos":[0,0.08,-0.07]},{"id":"footL","pos":[0.13,0.03,0.02]},{"id":"footR","pos":[-0.13,0.03,0.02]},{"id":"eyeL","parent":"head","pos":[0.13,0.03,0.26]},{"id":"eyeR","parent":"head","pos":[-0.13,0.03,0.26]},{"id":"mouth","parent":"head","pos":[0,-0.105,0.3]}],"parts":[{"type":"ellipsoid","bone":"torso","size":[0.32,0.25,0.36],"pos":[0,0,0],"color":"body","seg":[14,10]},{"type":"ellipsoid","bone":"head","size":[0.32,0.3,0.3],"pos":[0,0,0],"color":"body","seg":[14,10]},{"type":"ellipsoid","bone":"head","size":[0.13,0.04,0.11],"pos":[0,-0.085,0.28],"color":"accent","seg":[14,10]},{"type":"ellipsoid","bone":"jaw","size":[0.095,0.026,0.08],"pos":[0,-0.015,0.05],"color":"low","seg":[14,10]},{"type":"ellipsoid","bone":"head","size":[0.045,0.03,0.01],"pos":[0.2,-0.08,0.235],"color":"cheek","seg":[14,10],"plain":true},{"type":"ellipsoid","bone":"head","size":[0.045,0.03,0.01],"pos":[-0.2,-0.08,0.235],"color":"cheek","seg":[14,10],"plain":true},{"type":"ellipsoid","bone":"tuft","size":[0.03,0.07,0.03],"pos":[0,0.04,0],"color":"body","rot":[0,0,-0.5],"seg":[14,10]},{"type":"ellipsoid","bone":"wingL","size":[0.05,0.14,0.12],"pos":[0.04,-0.09,0],"color":"wing","seg":[14,10]},{"type":"ellipsoid","bone":"wingR","size":[0.05,0.14,0.12],"pos":[-0.04,-0.09,0],"color":"wing","seg":[14,10]},{"type":"ellipsoid","bone":"tail","size":[0.06,0.11,0.05],"pos":[0,0.02,-0.04],"color":"body","rot":[-0.9,0,0],"seg":[14,10]},{"type":"ellipsoid","bone":"tail
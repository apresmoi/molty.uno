# Waveshare ESP32-S3-Touch-LCD-1.46 — layered over sdkconfig.defaults(.esp32s3)
# when this board is built (firmware/CMakeLists.txt, scripts/firmware-build.sh).
# Mirrors Waveshare 1.46 demo bundle: ESP-IDF/.../sdkconfig.defaults.
CONFIG_MOLTY_BOARD_WAVESHARE_ESP32_S3_TOUCH_LCD_1_46=y

# Flash: 16 MB QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM: 8 MB OPI (octal) — the N16R8 module
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console: NONE. The 1.46 has no UART bridge, and USB-Serial-JTAG conflicts
# with TinyUSB (both want the same USB peripheral). For the portal we accept
# zero serial logs — debug visibility goes through HTTP endpoints instead.
CONFIG_ESP_CONSOLE_NONE=y

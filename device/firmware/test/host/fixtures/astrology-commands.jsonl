{"name":"scene.play","args":{"pkg":"astrology","layout":"chart","params":{"bodies":[{"g":"g-mercury","a":242.98,"r":0.64,"c":"#c8bcb0","say":"Mercury in Gemini: your mind works best by talking and learning. Venus lends a hand.","id":"mercury"},{"g":"g-sun","a":255.4,"r":0.54,"c":"#ffd678","say":"Sun in Gemini: you shine through ideas and quick wits. Jupiter lends a hand.","id":"sun"},{"g":"g-venus","a":300.56,"r":0.64,"c":"#fff0c4","say":"Venus in Leo: you love with warmth and a big heart. Mercury lends a hand.","id":"venus"},{"g":"g-mars","a":306.53,"r":0.54,"c":"#ff7a55","say":"Mars in Leo: you go after things by being seen and playing. Saturn pulls the other way, so look for balance.","id":"mars"},{"g":"g-jupiter","a":309.91,"r":0.44,"c":"#ffc266","say":"Jupiter in Leo: luck finds you with warmth and a big heart. Mars sits right beside it, so the two blend.","id":"jupiter"},{"g":"g-pluto","a":48.26,"r":0.64,"c":"#c0a0d0","say":"Pluto in Scorpio: you change deep down with deep, all or nothing focus. Neptune lends a hand.","id":"pluto"},{"g":"g-uranus","a":102.89,"r":0.64,"c":"#9fe3e0","say":"Uranus in Capricorn: you break old rules with patience and quiet ambition. Neptune sits right beside it, so the two blend.","id":"uranus"},{"g":"g-neptune","a":106.18,"r":0.54,"c":"#8fb4ff","say":"Neptune in Capricorn: you dream by climbing step by step. Pluto lends a hand.","id":"neptune"},{"g":"g-saturn","a":126.51,"r":0.64,"c":"#e8d890","say":"Saturn in Aquarius: you learn hard lessons by doing it your own way. Mars pulls the other way, so look for balance.","id":"saturn"},{"g":"g-moon","a":176.91,"r":0.64,"c":"#e6e6e0","say":"Moon in Pisces: you feel at home through dreams and kindness. Venus makes it flow easily.","id":"moon"}],"aspects":[{"x1":0.271,"y1":-0.366,"x2":-0.33,"y2":0.446,"px1":0.321,"py1":-0.434,"px2":-0.381,"py2":0.514,"c":"#ff5a4a","say":"Mars opposes Saturn: drive meets limits.","id":"mars-saturn","lights":"mars-saturn mars saturn"},{"x1":-0.066,"y1":0.513,"x2":0.341,"y2":0.484,"px1":-0.15,"py1":0.519,"px2":0.426,"py2":0.478,"c":"#6fa8ff","say":"Neptune helps Pluto: dreams helping power.","id":"neptune-pluto","lights":"neptune-pluto neptune pluto"},{"x1":-0.206,"y1":-0.568,"x2":0.24,"y2":-0.554,"px1":-0.291,"py1":-0.57,"px2":0.325,"py2":-0.551,"c":"#6fa8ff","say":"Mercury helps Venus: mind helping love.","id":"mercury-venus","lights":"mercury-venus mercury venus"}],"signs":[{"a":195,"say":"Aries: bold, quick fire, ruled by Mars. Empty now, so its ruler, Mars in Leo, shows how it plays out for you.","id":"aries"},{"a":225,"say":"Taurus: steady, sensual earth, ruled by Venus. Empty now, so its ruler, Venus in Leo, shows how it plays out for you.","id":"taurus"},{"a":255,"say":"Gemini: curious, chatty air, ruled by Mercury. Mercury and Sun here: by talking and learning, you live out your mind and your core self.","id":"gemini"},{"a":285,"say":"Cancer: caring, tender water, ruled by the Moon. Empty now, so its ruler, the Moon in Pisces, shows how it plays out for you.","id":"cancer"},{"a":315,"say":"Leo: warm, proud fire, ruled by the Sun. Venus, Mars and Jupiter here: with warmth and a big heart, you live out your loves, your drive and your luck.","id":"leo"},{"a":345,"say":"Virgo: careful, helpful earth, ruled by Mercury. Empty now, so its ruler, Mercury in Gemini, shows how it plays out for you.","id":"virgo"},{"a":15,"say":"Libra: fair, graceful air, ruled by Venus. Empty now, so its ruler, Venus in Leo, shows how it plays out for you.","id":"libra"},{"a":45,"say":"Scorpio: deep, intense water, ruled by Pluto. Pluto here: with deep, all or nothing focus, you live out your power.","id":"scorpio"},{"a":75,"say":"Sagittarius: free, far-roaming fire, ruled by Jupiter. Empty now, so its ruler, Jupiter in Leo, shows how it plays out for you.","id":"sagittarius"},{"a":105,"say":"Capricorn: patient, ambitious earth, ruled by Saturn. Uranus and Neptune here: with patience and quiet ambition, you live out your rebel side and your dreams.","id":"capricorn"},{"a":135,"say":"Aquarius: original, free-thinking air, ruled by Uranus. Saturn here: by doing it your own way, you live out your discipline.","id":"aquarius"},{"a":165,"say":"Pisces: dreamy, gentle water, ruled by Neptune. Moon here: through dreams and kindness, you live out your feelings.","id":"pisces"}]},"ttl_s":60}}
